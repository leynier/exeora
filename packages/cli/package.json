{
  "name": "exeora",
  "version": "0.1.0",
  "description": "Connect any MCP client to the development environment on any machine (even your own), without opening a port or uploading your source code.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "cli",
    "claude",
    "cursor"
  ],
  "homepage": "https://exeora.dev",
  "bugs": "https://exeora.dev",
  "license": "MIT",
  "author": "Leynier Gutiérrez González <leynier41@gmail.com>",
  "type": "module",
  "bin": {
    "exeora": "./bin/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@napi-rs/keyring": "1.3.0",
    "commander": "15.0.0",
    "conf": "15.1.0",
    "diff": "8.0.4",
    "execa": "10.0.1",
    "ignore": "7",
    "open": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@exeora/protocol": "workspace:*",
    "@types/node": "latest",
    "tsdown": "0.22.14"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "tsdown"
  }
}
