{
  "name": "exeora",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "bun": ">=1.4.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.25.12",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "http-cache-semantics": "4.3.0",
    "miniflare>undici": "^7.30.1",
    "unifont>undici": "^8.12.2",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.4",
    "smol-toml": "^1.9.0",
    "vite": "^8.2.4",
    "zod": "^4.6.6",
    "hono": "^4.13.11",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:file-length": "bun run scripts/check-file-length.ts",
    "typecheck": "tsc --build && tsc -p apps/web/dashboard/tsconfig.json && bun run --cwd apps/extension types && tsc -p apps/extension/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "bun run --cwd apps/web build && playwright test",
    "ci": "bun run check && bun run check:file-length && bun run typecheck && bun run --cwd apps/web build && bun run --cwd apps/extension build && bun run test",
    "brand": "bun run scripts/brand-assets.ts",
    "plugin:build": "bun run scripts/build-plugin.ts",
    "plugin:build:claude": "bun run scripts/build-claude-plugin.ts",
    "icons": "bun run scripts/file-icons.ts",
    "dev": "bun run --cwd apps/web build && bun run --cwd apps/gateway dev",
    "ext:dev": "bun run --cwd apps/extension dev",
    "ext:build": "bun run --cwd apps/extension build",
    "deploy": "bun run --cwd apps/web build && bun run --cwd apps/gateway deploy",
    "db:generate": "bun run --cwd apps/gateway db:generate",
    "db:migrate:local": "bun run --cwd apps/gateway db:migrate:local",
    "db:migrate": "bun run --cwd apps/gateway db:migrate",
    "types": "bun run --cwd apps/gateway types",
    "secret": "bun run --cwd apps/gateway secret",
    "protocol:rust": "bun run scripts/generate-rust-contract.ts && cargo run -p exeora-protocol-gen",
    "plugin:build:cursor": "bun run scripts/build-cursor-plugin.ts",
    "plugin:build:agent": "bun run scripts/build-agent-plugin.ts",
    "plugin:build:copilot": "bun run scripts/build-copilot-plugin.ts",
    "plugin:build:experimental": "bun run scripts/build-experimental-plugin.ts",
    "plugin:check:submission": "bun run scripts/check-openai-submission.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@exeora/design": "workspace:*",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "latest",
    "ajv": "8.20.0",
    "fflate": "^0.8.3",
    "material-icon-theme": "5.38.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.12",
    "zod": "^4.6.6"
  }
}
