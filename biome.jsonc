{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // `**/public` is static assets: fonts, brand marks, the built site. Nothing
    // there is written by hand, and linting an .svg asset as though it were
    // inline markup is wrong on its own terms: the client marks are painted
    // through a CSS mask onto an aria-hidden span, so a screen reader never
    // reaches the file's contents and a <title> inside it would be read by
    // nobody.
    "includes": [
      "**",
      "!.amp/plugins",
      "!**/dist",
      "!**/public",
      "!**/.astro",
      "!**/.wrangler",
      "!crates/exeora-cli/protocol/*.json",
      "!**/worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/landing/src/styles/global.css", "apps/web/dashboard/src/index.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
