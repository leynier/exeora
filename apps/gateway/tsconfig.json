{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Runtime types come from worker-configuration.d.ts, generated by
    // `bun run types`. @cloudflare/workers-types is superseded by it.
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "cloudflare-test.d.ts"],
  "references": [{ "path": "../../packages/protocol" }]
}
