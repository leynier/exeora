{
  "name": "@exeora/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787 --upstream-protocol http",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "secret": "wrangler secret put",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply exeora --local",
    "db:migrate": "wrangler d1 migrations apply exeora --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.4",
    "@exeora/design": "workspace:*",
    "@exeora/protocol": "workspace:*",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/server": "2.1.0",
    "agents": "0.24.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "latest",
    "drizzle-kit": "latest",
    "wrangler": "4.140.0"
  }
}
