# Copy to .dev.vars (git-ignored) and fill in.
# In production these are set with `wrangler secret put <NAME>`.

# GitHub OAuth app — callback: http://localhost:8787/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth web client — callback: http://localhost:8787/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string: openssl rand -hex 32
COOKIE_SECRET=

# Signs the approval that travels through an AI client and comes back, so a
# client cannot mint its own. Separate from COOKIE_SECRET on purpose: they
# protect different things for different audiences. At least 32 bytes.
# openssl rand -hex 32
REQUEST_STATE_SECRET=

# Overrides the wrangler.jsonc var during local development, so provider
# callbacks point at localhost instead of the production route.
EXEORA_BASE_URL=http://localhost:8787

# Exeora Cloud. Both optional: leave them unset and the Cloud routes answer
# `cloud_disabled`. A machine dials the gateway back over the public internet,
# so Cloud only works against a public EXEORA_BASE_URL, never localhost.
# Organisation token from https://sprites.dev/account (org/id/secret).
SPRITES_TOKEN=
# Encrypts repository tokens at rest: openssl rand -hex 32
CLOUD_CREDENTIALS_KEY=

# GitHub App, which connects an account's repositories. Not the OAuth app
# above: that one signs people in, this one lists and clones. All six or none,
# and CLOUD_CREDENTIALS_KEY above with them, which encrypts the token of each
# person who connects: with any of the seven unset the routes answer
# `github_disabled`.
# Create it at https://github.com/settings/apps/new with
#   callback: http://localhost:8787/api/github/callback
#   "Request user authorization (OAuth) during installation" checked
#   webhook:  <a public URL>/api/github/webhook (GitHub cannot reach localhost)
GITHUB_APP_ID=
# The name in the app's address, github.com/apps/<slug>
GITHUB_APP_SLUG=
# The .pem GitHub downloads, on one line with \n for each line break
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Any long random string, the same one typed into the app: openssl rand -hex 32
GITHUB_APP_WEBHOOK_SECRET=

# Exeora for Chrome, optional. The id the committed key in
# apps/extension/wxt.config.ts pins, so `bun run ext:dev` can sign in here.
# Never in production: that key is public.
EXEORA_EXTENSION_IDS=helnfgncjgikiojakjdfppmmflbdjamo
