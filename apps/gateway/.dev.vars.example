# Copy to .dev.vars (git-ignored) and fill in.
# In production these are set with `wrangler secret put <NAME>`.

# GitHub OAuth app — callback: http://localhost:8787/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth web client — callback: http://localhost:8787/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string: openssl rand -hex 32
COOKIE_SECRET=

# Signs the approval that travels through an AI client and comes back, so a
# client cannot mint its own. Separate from COOKIE_SECRET on purpose: they
# protect different things for different audiences. At least 32 bytes.
# openssl rand -hex 32
REQUEST_STATE_SECRET=

# Overrides the wrangler.jsonc var during local development, so provider
# callbacks point at localhost instead of the production route.
EXEORA_BASE_URL=http://localhost:8787
