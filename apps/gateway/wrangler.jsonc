{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exeora-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: the MCP SDK and OAuth provider reach for node builtins.
  // global_fetch_strictly_public: required by workers-oauth-provider to fetch
  // Client ID Metadata Documents (CIMD) without looping back into this Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "DEVICE_RELAY", "class_name": "DeviceRelay" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRelay"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exeora",
      "database_id": "f64c25ac-8209-40a8-b971-8432c7b6a867",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "9eaeb4270e5d4ef996018912075d97bc" }],

  // The OAuth screens are the one place this Worker renders HTML, and they
  // inline their CSS: a sign-in page cannot afford a blocking stylesheet
  // request. This rule lets them import the shared design tokens as a string
  // so the palette is written down once rather than copied. Scoped to that one
  // filename rather than `*.css`, which would claim every stylesheet, and
  // `fallthrough` so it adds to wrangler's built-in Text rule for .txt/.html/
  // .sql rather than replacing it.
  "rules": [{ "type": "Text", "globs": ["**/tokens.css"], "fallthrough": true }],

  // The landing and dashboard, built by apps/web. `run_worker_first` because
  // the OAuth provider has to see every request: it owns /oauth/token and the
  // metadata documents, and only what it does not claim reaches the assets.
  // `not_found_handling: none` because the Worker decides the fallback itself,
  // sending /dashboard/* to the SPA shell and everything else to a real 404.
  "assets": {
    "directory": "../web/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "vars": {
    "EXEORA_BASE_URL": "https://exeora.dev"
  },

  // One Worker owns the whole hostname now, so a single route replaces the
  // four path patterns this used to need.
  //
  // `wrangler dev` takes its origin from this route and rewrites every request
  // URL to exeora.dev. The OAuth provider derives its metadata `issuer` and the
  // RFC 9207 `iss` from that URL, so a local login would hand back
  // iss=http://exeora.dev while the client was talking to localhost, which a
  // client that validates the issuer correctly rejects. The `dev` script passes
  // --local-upstream to pin the origin back to localhost:8787.
  "routes": [{ "pattern": "exeora.dev/*", "zone_name": "exeora.dev" }]
}
