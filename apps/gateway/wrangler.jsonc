{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exeora-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: the MCP SDK and OAuth provider reach for node builtins.
  // global_fetch_strictly_public: required by workers-oauth-provider to fetch
  // Client ID Metadata Documents (CIMD) without looping back into this Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // Nightly housekeeping: prunes the audit log past its retention window and
  // lets the OAuth provider drop grants and tokens that have expired. Neither
  // has anything to do with a request, and both grow without bound otherwise.
  "triggers": { "crons": ["17 4 * * *"] },

  "durable_objects": {
    "bindings": [{ "name": "DEVICE_RELAY", "class_name": "DeviceRelay" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRelay"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exeora",
      "database_id": "f64c25ac-8209-40a8-b971-8432c7b6a867",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "9eaeb4270e5d4ef996018912075d97bc" }],

  // Rate limiting. Three namespaces because the three surfaces have nothing in
  // common: signing in is rare, registering a machine is rarer, and an agent
  // working through a repository makes hundreds of tool calls a minute.
  //
  // This is a blunt instrument on purpose, and worth being clear about what it
  // is not. The counters are per data centre rather than global, and `period`
  // accepts only 10 or 60 seconds. It stops someone hammering an endpoint; it
  // is not a quota, and nothing here is billing.
  //
  // The namespace ids are arbitrary and only have to stay distinct from each
  // other. They are not secrets and not resources to create anywhere.
  "ratelimits": [
    // Unauthenticated, so keyed by IP: token exchange and dynamic client
    // registration, which is the pair anyone can reach without a token.
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Keyed by user: registering machines and projects. A person does this a
    // handful of times ever, so anything near this ceiling is a loop.
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    // Keyed by user: tool calls. Deliberately generous, because a coding agent
    // reading its way through a repository is meant to be fast.
    { "name": "RL_MCP", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],

  // The OAuth screens are the one place this Worker renders HTML, and they
  // inline their CSS: a sign-in page cannot afford a blocking stylesheet
  // request. This rule lets them import the shared design tokens as a string
  // so the palette is written down once rather than copied. Scoped to that one
  // filename rather than `*.css`, which would claim every stylesheet, and
  // `fallthrough` so it adds to wrangler's built-in Text rule for .txt/.html/
  // .sql rather than replacing it.
  "rules": [{ "type": "Text", "globs": ["**/tokens.css"], "fallthrough": true }],

  // The landing and dashboard, built by apps/web. `run_worker_first` because
  // the OAuth provider has to see every request: it owns /oauth/token and the
  // metadata documents, and only what it does not claim reaches the assets.
  // `not_found_handling: none` because the Worker decides the fallback itself,
  // sending /dashboard/* to the SPA shell and everything else to a real 404.
  "assets": {
    "directory": "../web/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "vars": {
    "EXEORA_BASE_URL": "https://exeora.dev",

    // The newest published CLI, told to every executor in the `hello.ack` so
    // `connect` can say a newer one exists. A var rather than a constant in the
    // source, so releasing the CLI is one line here and not a code change; and
    // told by us rather than looked up on npm, so connecting never depends on
    // the registry being reachable.
    "LATEST_CLI_VERSION": "0.7.0",

    // Where the audit archive lives, for the nightly rollup that rebuilds
    // `usage_daily` out of R2 SQL. Not secret: the account id is in every
    // dashboard URL, and the table is only reachable with the token below it.
    // `AUDIT_R2_SQL_TOKEN` is a secret and is set with `wrangler secret put`.
    "CLOUDFLARE_ACCOUNT_ID": "6df65be91ad130fd6aa8cb64ac017f22",
    "AUDIT_R2_BUCKET": "exeora-audit",
    "AUDIT_R2_WAREHOUSE": "6df65be91ad130fd6aa8cb64ac017f22_exeora-audit",
    "AUDIT_R2_TABLE": "default.tool_calls",

    // The first UTC day the Iceberg table can contain, which is the day dual
    // mode was switched on. Dating it earlier only makes the rollup query
    // empty days every night for nothing.
    "AUDIT_WAREHOUSE_START_DAY": "2026-08-08",

    // The cutover. `tool_calls` stops being written on the request path and the
    // Iceberg table becomes the only copy, so Activity reads it through R2 SQL
    // and `usage_daily` is rebuilt from it nightly. A call becomes visible when
    // the sink rolls its file rather than the instant it is made.
    "AUDIT_WRITE_MODE": "pipeline"
  },

  // The audit stream. `AUDIT_WRITE_MODE` decides whether anything is sent to
  // it: unset means `d1` and the binding sits idle, which is why the binding
  // can land here before the cutover rather than with it.
  "pipelines": [
    {
      "binding": "AUDIT_STREAM",
      "stream": "73d00047ba1f483482a3a85b4ce157eb"
    }
  ],

  // One Worker owns the whole hostname now, so a single route replaces the
  // four path patterns this used to need.
  //
  // `wrangler dev` takes its origin from this route and rewrites every request
  // URL to exeora.dev. The OAuth provider derives its metadata `issuer` and the
  // RFC 9207 `iss` from that URL, so a local login would hand back
  // iss=http://exeora.dev while the client was talking to localhost, which a
  // client that validates the issuer correctly rejects. The `dev` script passes
  // --local-upstream to pin the origin back to localhost:8787.
  "routes": [{ "pattern": "exeora.dev/*", "zone_name": "exeora.dev" }]
}
