{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exeora-web",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker decides: /dashboard/* falls back to the SPA shell, everything
    // else to the landing's own 404. A single global mode cannot express that.
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // Deliberately last in specificity: the gateway claims /oauth/*, /api/*,
  // /p/* and /.well-known/*, and everything else lands here.
  "routes": [{ "pattern": "exeora.dev/*", "zone_name": "exeora.dev" }]
}
