---
import Section from "./Section.astro";

/**
 * What is deliberately missing, stated as what comes next. Every item here is
 * absent from the current release; none of it is implied to exist.
 */

const items = [
  {
    title: "Approve a call before it runs",
    body: "MCP 2026-07-28 standardised inputRequired, so the client can be asked to confirm mid-call. That turns run_command from a leap of faith into a prompt.",
  },
  {
    title: "Command allowlists",
    body: "Per project rules for what run_command may execute, so a project can be read-only, or limited to a test runner.",
  },
  {
    title: "Sign in with Google",
    body: "Identity already sits behind a provider interface, and the database column is plain text. Adding one is a file and two secrets, not a migration.",
  },
  {
    title: "Long-running processes",
    body: "start_command and get_command_output, for a dev server or a watch task. It needs an asynchronous shape in the relay, which is why it is not simply a seventh tool.",
  },
];
---

<Section
  id="roadmap"
  eyebrow="Roadmap"
  title="What comes next"
  subtitle="Named here because they are not in this release, and it is better to say so than to let a demo imply otherwise"
>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      items.map((item, index) => (
        <article
          class="animate-fade-in-up opacity-0-initial border-border bg-surface flex gap-4 rounded-xl border p-5"
          style={`animation-delay: ${120 + index * 70}ms`}
        >
          <span
            aria-hidden="true"
            class="bg-accent-subtle text-foreground-faint mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-md"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
          <div>
            <h3 class="text-title-lg">{item.title}</h3>
            <p class="text-body-md text-foreground-muted mt-1.5">{item.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</Section>
