---
import { GITHUB_URL, RELEASES_URL } from "../lib/site.js";
import InstallCommands from "./InstallCommands.astro";
---

<section id="get-started" class="defer-offscreen-rendering border-border-subtle relative overflow-hidden border-t px-6 py-24">
  <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-80"></div>

  <div class="animate-fade-in-up opacity-0-initial relative z-10 mx-auto max-w-xl text-center">
    <p class="text-label-md text-foreground-muted font-mono uppercase">Free while Pro is in development</p>
    <h2 class="text-headline-lg mt-3 sm:text-[32px]">Connect your first machine</h2>
    <p class="text-body-lg text-foreground-muted mt-4">
      One native binary, one browser sign-in, and an MCP URL for the client you already use. No
      credit card and no model subscription from us.
    </p>

    <ul class="text-body-md text-foreground-muted mt-6 flex flex-wrap justify-center gap-x-4 gap-y-2">
      <li><strong class="text-foreground">10</strong> live machines</li>
      <li aria-hidden="true">·</li>
      <li><strong class="text-foreground">25</strong> projects</li>
      <li aria-hidden="true">·</li>
      <li><strong class="text-foreground">90 days</strong> of audit history</li>
    </ul>

    <div class="mx-auto mt-8 max-w-xl"><InstallCommands id="cta" /></div>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/dashboard/"
        class="bg-accent text-on-accent hover:bg-foreground text-title-md w-full rounded-lg px-5 py-3 transition-colors duration-fast sm:w-auto"
      >
        Connect a machine for free
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="border-border text-foreground-muted hover:text-foreground hover:border-foreground-faint/30 text-title-md w-full rounded-lg border px-5 py-3 transition-colors duration-fast sm:w-auto"
      >
        View the source
      </a>
    </div>

    <p class="text-body-md text-foreground-faint mt-8">
      macOS, Linux and Windows · Self-hostable ·{" "}
      <a href={RELEASES_URL} target="_blank" rel="noopener" class="hover:text-foreground underline-offset-2 hover:underline"
        >Releases</a
      >
    </p>
  </div>
</section>
