---
import { GITHUB_URL, NPM_URL } from "../lib/site.js";
---

<section class="defer-offscreen-rendering border-border-subtle relative overflow-hidden border-t px-6 py-24">
  <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-80"></div>

  <div class="animate-fade-in-up opacity-0-initial relative z-10 mx-auto max-w-xl text-center">
    <h2 class="text-headline-lg sm:text-[32px]">Point an agent at a machine</h2>
    <p class="text-body-lg text-foreground-muted mt-4">
      One command, one browser sign-in, and a URL you paste into whichever client you already use.
      Run it wherever the work is. Open source under AGPL-3.0 - every line is on GitHub.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/dashboard/"
        class="bg-accent text-on-accent hover:bg-foreground text-title-md w-full rounded-lg px-5 py-2.5 transition-colors duration-fast sm:w-auto"
      >
        Open the dashboard
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="border-border text-foreground-muted hover:text-foreground hover:border-foreground-faint/30 text-title-md w-full rounded-lg border px-5 py-2.5 transition-colors duration-fast sm:w-auto"
      >
        View the source
      </a>
    </div>

    <p class="text-body-md text-foreground-faint mt-8">
      Requires Node 22 or newer · macOS, Linux and Windows ·{" "}
      <a href={NPM_URL} target="_blank" rel="noopener" class="hover:text-foreground underline-offset-2 hover:underline"
        >CLI on npm</a
      >
    </p>
  </div>
</section>
