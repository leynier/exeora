---
import { MARK_RADIUS, MARK_TILE, MARK_TILES, MARK_VIEWBOX } from "@exeora/design/mark";

/**
 * The mark plus the name.
 *
 * The geometry comes from `@exeora/design/mark`, which also feeds the favicon
 * and every downloadable file on /brand, so the shape cannot drift between
 * where it is shown and where it is handed out.
 */

interface Props {
  href?: string;
  class?: string;
}

const { href = "/", class: className = "" } = Astro.props;
---

<a href={href} class:list={["group flex items-center gap-2.5", className]} aria-label="Exeora, home">
  <svg
    viewBox={MARK_VIEWBOX}
    class="text-foreground h-[16px] w-auto shrink-0"
    aria-hidden="true"
    fill="currentColor"
    xmlns="http://www.w3.org/2000/svg"
  >
    {
      MARK_TILES.map((tile) => (
        <rect x={tile.x} y={tile.y} width={MARK_TILE} height={MARK_TILE} rx={MARK_RADIUS} />
      ))
    }
  </svg>
  <span class="text-title-lg tracking-tight">Exeora</span>
</a>
