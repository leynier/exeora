---
/**
 * The mark plus the name.
 *
 * Three tiles: one above, two below and apart. A client, the gateway, and the
 * machine that does the work, meeting at the corners rather than merging.
 *
 * The tiles are 22 wide on a pitch of 20, so they overlap by exactly the corner
 * radius and the silhouette closes at the two junctions instead of pinching to
 * a point. Anything that redraws this mark (the favicon, the OAuth screens, the
 * dashboard) uses the same three numbers.
 */

interface Props {
  href?: string;
  class?: string;
}

const { href = "/", class: className = "" } = Astro.props;
---

<a href={href} class:list={["group flex items-center gap-2.5", className]} aria-label="Exeora, home">
  <svg
    viewBox="0 0 62 42"
    class="text-brand h-[15px] w-auto shrink-0"
    aria-hidden="true"
    fill="currentColor"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="20" y="0" width="22" height="22" rx="2"></rect>
    <rect x="0" y="20" width="22" height="22" rx="2"></rect>
    <rect x="40" y="20" width="22" height="22" rx="2"></rect>
  </svg>
  <span class="text-title-lg tracking-tight">Exeora</span>
</a>
