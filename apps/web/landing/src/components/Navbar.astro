---
import { GITHUB_URL } from "../lib/site.js";
import Wordmark from "./Wordmark.astro";

const links = [
  { href: "/#use-cases", label: "Use cases" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#compare", label: "Compare" },
  { href: "/docs/", label: "Docs" },
];
---

<header
  class="border-border-subtle bg-bg/70 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-6">
    <Wordmark />

    <div class="text-body-md text-foreground-muted hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <a href={link.href} class="hover:text-foreground transition-colors duration-fast">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="text-body-md text-foreground-muted hover:text-foreground hidden items-center gap-1.5 rounded-lg px-2.5 py-1.5 transition-colors duration-fast sm:inline-flex"
        aria-label="Exeora on GitHub"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          ></path>
        </svg>
        GitHub
      </a>
      <a
        href="/dashboard/"
        class="text-body-md bg-accent text-on-accent hover:bg-foreground rounded-lg px-3.5 py-1.5 font-medium transition-colors duration-fast"
      >
        Dashboard
      </a>

      <!-- Mobile menu toggle. Hidden from md up, where the inline links show. -->
      <button
        type="button"
        id="nav-menu-toggle"
        class="text-foreground-muted hover:text-foreground hover:bg-surface-variant inline-flex size-9 items-center justify-center rounded-lg transition-colors duration-fast md:hidden"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        aria-label="Open menu"
      >
        <svg
          data-icon="open"
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          data-icon="close"
          viewBox="0 0 24 24"
          class="hidden size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="nav-mobile-menu"
    aria-hidden="true"
    class="border-border-subtle bg-bg/95 hidden border-t backdrop-blur-xl md:hidden"
  >
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-6 py-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-mobile-link
            class="text-body-lg text-foreground-muted hover:text-foreground hover:bg-surface-variant rounded-lg px-3 py-2.5 transition-colors duration-fast"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        data-nav-mobile-link
        class="text-body-lg text-foreground-muted hover:text-foreground hover:bg-surface-variant rounded-lg px-3 py-2.5 transition-colors duration-fast sm:hidden"
      >
        GitHub
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-menu-toggle");
  const menu = document.getElementById("nav-mobile-menu");
  if (toggle && menu) {
    const openIcon = toggle.querySelector("[data-icon='open']");
    const closeIcon = toggle.querySelector("[data-icon='close']");

    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      menu.setAttribute("aria-hidden", open ? "false" : "true");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => {
      setOpen(menu.classList.contains("hidden"));
    });

    for (const link of menu.querySelectorAll("[data-nav-mobile-link]")) {
      link.addEventListener("click", () => setOpen(false));
    }

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || menu.classList.contains("hidden")) return;
      setOpen(false);
      toggle.focus();
    });

    document.addEventListener("click", (event) => {
      if (menu.classList.contains("hidden")) return;
      const target = event.target;
      if (target instanceof Node && !menu.contains(target) && !toggle.contains(target)) {
        setOpen(false);
      }
    });
  }
</script>
