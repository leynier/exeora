---
import { GITHUB_URL } from "../lib/site.js";
import Wordmark from "./Wordmark.astro";

const links = [
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#features", label: "Features" },
  { href: "/#tools", label: "Tools" },
  { href: "/#compare", label: "Compare" },
  { href: "/#faq", label: "FAQ" },
  { href: "/docs/", label: "Docs" },
];
---

<header
  class="border-border-subtle bg-bg/70 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-6">
    <Wordmark />

    <div class="text-body-md text-foreground-muted hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <a href={link.href} class="hover:text-foreground transition-colors duration-fast">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="text-body-md text-foreground-muted hover:text-foreground hidden items-center gap-1.5 rounded-lg px-2.5 py-1.5 transition-colors duration-fast sm:inline-flex"
        aria-label="Exeora on GitHub"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          ></path>
        </svg>
        GitHub
      </a>
      <a
        href="/dashboard/"
        class="text-body-md bg-accent text-on-accent hover:bg-foreground rounded-lg px-3.5 py-1.5 font-medium transition-colors duration-fast"
      >
        Dashboard
      </a>
    </div>
  </nav>
</header>
