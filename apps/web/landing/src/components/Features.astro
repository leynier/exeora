---
import Section from "./Section.astro";

/**
 * What the system actually guarantees, one card per guarantee. Six pillars
 * rather than a full inventory: the rest lives in docs. Each line is something
 * the code does today, not a roadmap item.
 */

const features = [
  {
    title: "No inbound path",
    body: "Nothing listens on the machine. The CLI opens an outbound connection and holds it, so home routers, corporate proxies and cloud VMs with no public address all work unconfigured",
    icon: "M12 3l7 3v6c0 4-3 7.5-7 9-4-1.5-7-5-7-9V6l7-3z",
  },
  {
    title: "Your code never leaves",
    body: "Exeora routes tool calls; it does not store the repository. Files are read, searched and edited where they already are, and only the result of a call crosses the wire",
    icon: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z",
  },
  {
    title: "Blast radius you choose",
    body: "Every URL is its own OAuth resource, so a token for one project is refused at another. Paths are resolved through realpath before anything touches disk - `..` and outward symlinks are rejected",
    icon: "M14 8a4 4 0 1 0-3.6 4L4 18.4V21h3v-2h2v-2h1.6L14 13.6A4 4 0 0 0 14 8z",
  },
  {
    title: "Policy you can tighten",
    body: "Read only, allow list, deny list, per-tool restrictions, and optional approval before edits and commands. Shell metacharacters are refused whenever a list is in force",
    icon: "M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 12h6M9 16h4",
  },
  {
    title: "Audit without leaking",
    body: "Which tool ran, how it ended, how long it took, and which client asked. Never the arguments, never the output - a log you can show someone",
    icon: "M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01",
  },
  {
    title: "Revoke and it stops",
    body: "Closing a machine kills the live socket that instant, not when a token expires. The whole stack is open source under AGPL-3.0 - audit it, fork it, contribute",
    icon: "M12 3v9M7.5 6.5a8 8 0 1 0 9 0",
  },
];
---

<Section
  id="features"
  eyebrow="Guarantees"
  title="Built so the dangerous parts are small"
  subtitle="One outbound connection, one resource per project, rules you can tighten, and a log that records what happened without recording what was in it"
  wide
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature, index) => (
        <article
          class="animate-fade-in-up opacity-0-initial group border-border bg-surface hover:bg-surface-variant hover:border-foreground-faint/20 rounded-xl border p-6 transition-all duration-mid"
          style={`animation-delay: ${120 + index * 50}ms`}
        >
          <div class="bg-accent-subtle text-foreground flex size-9 items-center justify-center rounded-lg transition-transform duration-mid group-hover:scale-110">
            <svg
              viewBox="0 0 24 24"
              class="size-[18px]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={feature.icon} />
            </svg>
          </div>
          <h3 class="text-title-lg mt-4">{feature.title}</h3>
          <p class="text-body-md text-foreground-muted mt-2">{feature.body}</p>
        </article>
      ))
    }
  </div>

  <p
    class="animate-fade-in-up opacity-0-initial text-body-md text-foreground-faint mt-10 text-center"
    style="animation-delay: 420ms"
  >
    Fifteen tools, one project directory -{" "}
    <a href="/docs/tools/" class="text-foreground underline-offset-2 hover:underline">
      full tool reference
    </a>
  </p>
</Section>
