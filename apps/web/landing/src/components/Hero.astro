---
import { GITHUB_URL, QUICKSTART } from "../lib/site.js";
---

<section class="noise-overlay relative overflow-hidden px-6 pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-[36rem]"></div>

  <div class="relative z-10 mx-auto max-w-3xl text-center">
    <p
      class="animate-fade-in-up opacity-0-initial border-border bg-surface text-label-md text-foreground-muted inline-flex items-center gap-2 rounded-pill border px-3 py-1.5 font-mono uppercase"
      style="animation-delay: 80ms"
    >
      <span class="relative flex size-1.5">
        <span
          class="bg-brand absolute inline-flex size-full animate-ping rounded-full opacity-70"
        ></span>
        <span class="bg-brand relative inline-flex size-1.5 rounded-full"></span>
      </span>
      Outbound only
    </p>

    <h1
      class="animate-fade-in-up opacity-0-initial mt-7 text-[34px] leading-[1.05] font-semibold tracking-[-1.4px] sm:text-[52px] lg:text-[60px]"
      style="animation-delay: 160ms"
    >
      <span class="text-gradient-accent">Secure local execution</span><br />
      <span class="text-foreground-muted">for AI agents.</span>
    </h1>

    <p
      class="animate-fade-in-up opacity-0-initial text-body-lg text-foreground-muted mx-auto mt-6 max-w-xl sm:text-[17px]"
      style="animation-delay: 240ms"
    >
      Connect any MCP client to the development environment on your own machine, without opening a
      port, uploading your source code, or wiring up a tunnel.
    </p>

    <div
      class="animate-fade-in-up opacity-0-initial mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
      style="animation-delay: 320ms"
    >
      <a
        href="/dashboard/"
        class="bg-accent text-on-accent hover:bg-foreground text-title-md w-full rounded-lg px-5 py-2.5 transition-colors duration-fast sm:w-auto"
      >
        Get started
      </a>
      <a
        href={GITHUB_URL}
        rel="noopener"
        class="border-border text-foreground-muted hover:text-foreground hover:border-foreground-faint/30 text-title-md w-full rounded-lg border px-5 py-2.5 transition-colors duration-fast sm:w-auto"
      >
        View source
      </a>
    </div>

    <!-- The four commands that take someone from nothing to a connected
         project. Copying the block is the fastest path, so the button takes
         all four rather than one line at a time. -->
    <div
      class="animate-fade-in-up opacity-0-initial border-border bg-surface mt-12 overflow-hidden rounded-xl border text-left"
      style="animation-delay: 400ms"
    >
      <div class="border-border-subtle flex items-center justify-between border-b px-4 py-2.5">
        <span class="text-label-md text-foreground-faint font-mono uppercase">Quickstart</span>
        <button
          type="button"
          data-copy-target="hero-quickstart"
          class="text-label-md text-foreground-muted hover:text-foreground border-border hover:border-foreground-faint/30 rounded-md border px-2 py-1 font-mono transition-colors duration-fast"
        >
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <!-- The `$` prompt is drawn with ::before so it stays out of
           textContent, and copying the block yields runnable commands. -->
      <pre
        class="text-body-md text-foreground-muted overflow-x-auto p-4"><code id="hero-quickstart" class="font-mono">{QUICKSTART.map((line) => (
        <span class="block before:text-foreground-faint before:content-['$_'] before:select-none">{line}</span>
      ))}</code></pre>
    </div>
  </div>
</section>
