---
import { GITHUB_URL } from "../lib/site.js";
import ArchitectureDiagram from "./ArchitectureDiagram.astro";

/**
 * Lead with the work Exeora makes possible, then show how a call reaches the
 * machine, so the promise and the mechanism are read together. Installation
 * belongs at the end, after the visitor knows why they would install it.
 *
 * Brand marks live in public/clients/ as monochrome SVGs and are painted
 * through a CSS mask so they pick up the current color. Each one links to the
 * section of the client guide that sets it up.
 */

const clients = [
  { name: "Claude", logo: "/clients/claude.svg", anchor: "claude" },
  { name: "ChatGPT", logo: "/clients/chatgpt.svg", anchor: "chatgpt" },
  { name: "Cursor", logo: "/clients/cursor.svg", anchor: "cursor" },
  { name: "VS Code", logo: "/clients/vscode.svg", anchor: "vscode" },
  { name: "Copilot", logo: "/clients/copilot.svg", anchor: "copilot" },
  { name: "Devin", logo: "/clients/devin.svg", anchor: "devin" },
  { name: "Antigravity", logo: "/clients/antigravity.svg", anchor: "antigravity" },
  { name: "Amp", logo: "/clients/amp.svg", anchor: "amp" },
  { name: "Zed", logo: "/clients/zed.svg", anchor: "zed" },
  { name: "Grok", logo: "/clients/grok.svg", anchor: "grok" },
  { name: "Perplexity", logo: "/clients/perplexity.svg", anchor: "perplexity" },
  { name: "OpenCode", logo: "/clients/opencode.svg", anchor: "opencode" },
];

const promises = [
  "Free: 10 machines and 2 Cloud instances",
  "No inbound ports",
  "Open source, self-hostable",
];
---

<section class="noise-overlay relative overflow-hidden px-6 pt-28 pb-16 sm:pt-36 sm:pb-20">
  <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-[36rem]"></div>

  <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_0.95fr] lg:gap-14">
    <div class="text-center lg:text-left">
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="animate-fade-in-up opacity-0-initial border-border bg-surface/70 text-foreground-muted hover:text-foreground text-label-md inline-flex cursor-pointer items-center gap-2 rounded-pill border px-3.5 py-1.5 font-mono uppercase transition-colors duration-fast"
        style="animation-delay: 80ms"
      >
        <span class="bg-brand size-1.5 rounded-full"></span>
        Open source · remote MCP
      </a>

      <h1
        class="animate-fade-in-up opacity-0-initial text-foreground mt-7 text-[38px] leading-[1.03] font-semibold tracking-[-1.5px] sm:text-[52px] lg:text-[60px]"
        style="animation-delay: 160ms"
      >
        Let your AI work where your code <span class="text-gradient-accent">already runs.</span>
      </h1>

      <p
        class="animate-fade-in-up opacity-0-initial text-body-lg text-foreground-muted mx-auto mt-6 max-w-2xl sm:text-[17px] lg:mx-0"
        style="animation-delay: 240ms"
      >
        Exeora turns a project on your laptop, server, Raspberry Pi or Exeora Cloud into one MCP
        URL. Your AI reads, edits and runs it right there, under rules you set, without the code
        leaving the machine or a port being opened.
      </p>

      <div
        class="animate-fade-in-up opacity-0-initial mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row lg:justify-start"
        style="animation-delay: 320ms"
      >
        <a
          href="#get-started"
          class="bg-accent text-on-accent hover:bg-foreground text-title-md w-full rounded-lg px-5 py-3 transition-colors duration-fast sm:w-auto"
        >
          Get started free
        </a>
        <a
          href="/docs/"
          class="border-border text-foreground-muted hover:text-foreground hover:border-foreground-faint/30 text-title-md w-full rounded-lg border px-5 py-3 transition-colors duration-fast sm:w-auto"
        >
          Read the docs
        </a>
      </div>

      <ul
        class="animate-fade-in-up opacity-0-initial text-body-md text-foreground-muted mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 lg:justify-start"
        style="animation-delay: 380ms"
      >
        {
          promises.map((promise) => (
            <li class="flex items-center gap-1.5">
              <span class="text-brand" aria-hidden="true">✓</span>
              {promise}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="animate-fade-in-up opacity-0-initial" style="animation-delay: 260ms">
      <ArchitectureDiagram />
    </div>
  </div>

  <!-- Same section as the hero: clients are proof of the promise above, not a
       separate chapter with its own divider. -->
  <div
    class="animate-fade-in-up opacity-0-initial relative z-10 mx-auto mt-16 max-w-5xl text-center sm:mt-20"
    style="animation-delay: 460ms"
  >
    <p class="text-label-md text-foreground-muted text-center font-mono uppercase">
      Bring the AI client you already use
    </p>

    <ul class="mt-6 grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6">
      {
        clients.map((client) => (
          <li>
            <a
              href={`/docs/clients/#${client.anchor}`}
              class="text-foreground-muted hover:text-foreground hover:bg-surface/70 flex items-center justify-center gap-2 rounded-lg px-2 py-2 transition-colors duration-fast"
            >
              <span
                class="bg-current block size-[18px] opacity-80"
                style={`mask: url(${client.logo}) center / contain no-repeat; -webkit-mask: url(${client.logo}) center / contain no-repeat`}
                aria-hidden="true"
              />
              <span class="text-title-md">{client.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="text-body-md text-foreground-muted mt-5 text-center">
      No client plugin. If it speaks MCP over HTTP with OAuth, it connects.{" "}
      <a href="/docs/clients/" class="text-foreground underline-offset-2 hover:underline">
        Setup for each client
      </a>
    </p>
  </div>
</section>
