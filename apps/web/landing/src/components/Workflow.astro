---
import Section from "./Section.astro";

const steps = [
  {
    title: "The CLI dials out. Nothing dials in",
    body: "The machine opens an outbound WebSocket and holds it. No inbound port, no tunnel, no VPN - the same command works behind NAT and behind a corporate firewall",
  },
  {
    title: "Your code never leaves the machine",
    body: "Exeora routes tool calls; it does not store your repository. Files are read, searched and edited where they already are, and only the result of a call crosses the wire",
  },
  {
    title: "You choose the blast radius",
    body: "A project's own URL reaches that project and nothing else, because the project is in the path rather than in anything the client sends. One account URL covers several, and you tick which ones when you authorize it",
  },
];
---

<Section
  id="how-it-works"
  eyebrow="How it works"
  title="Three facts that explain the whole design"
  subtitle="No inbound network path, no copy of your code, and a blast radius you decide when you authorize a client"
>
  <ol class="relative grid gap-10 md:grid-cols-3 md:gap-8">
    <!-- The connector sits behind the numbers on desktop only, where the
         steps read left to right. -->
    <div
      aria-hidden="true"
      class="via-border absolute top-5 right-[16%] left-[16%] hidden h-px bg-gradient-to-r from-transparent to-transparent md:block"
    >
    </div>

    {
      steps.map((step, index) => (
        <li
          class="animate-fade-in-up opacity-0-initial relative"
          style={`animation-delay: ${140 + index * 90}ms`}
        >
          <span class="border-border bg-surface text-title-md text-foreground relative z-10 flex size-10 items-center justify-center rounded-full border font-mono">
            {index + 1}
          </span>
          <h3 class="text-headline-sm mt-5">{step.title}</h3>
          <p class="text-body-lg text-foreground-muted mt-2.5">{step.body}</p>
        </li>
      ))
    }
  </ol>
</Section>
