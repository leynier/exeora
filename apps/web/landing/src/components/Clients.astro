---
/**
 * Which clients this works with.
 *
 * Brand marks live in public/clients/ as monochrome SVGs and are painted
 * through a CSS mask so they pick up --color-foreground. Claude Code is
 * folded into Claude rather than shown as its own tile: same product,
 * same mark.
 */

const clients = [
  { name: "Claude", logo: "/clients/claude.svg" },
  { name: "ChatGPT", logo: "/clients/chatgpt.svg" },
  { name: "Cursor", logo: "/clients/cursor.svg" },
  { name: "VS Code", logo: "/clients/vscode.svg" },
  { name: "Copilot", logo: "/clients/copilot.svg" },
  { name: "Devin", logo: "/clients/devin.svg" },
  { name: "Antigravity", logo: "/clients/antigravity.svg" },
  { name: "Amp", logo: "/clients/amp.svg" },
  { name: "Zed", logo: "/clients/zed.svg" },
  { name: "Grok", logo: "/clients/grok.svg" },
  { name: "Perplexity", logo: "/clients/perplexity.svg" },
  { name: "OpenCode", logo: "/clients/opencode.svg" },
];
---

<section class="defer-offscreen-rendering px-6 py-16">
  <div class="mx-auto max-w-5xl">
    <p
      class="animate-fade-in-up opacity-0-initial text-label-md text-foreground-faint text-center font-mono uppercase"
    >
      Speaks MCP, so it works with
    </p>

    <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        clients.map((client, index) => (
          <li
            class="animate-fade-in-up opacity-0-initial border-border bg-surface hover:bg-surface-variant hover:border-foreground-faint/20 flex flex-col items-center justify-center gap-2.5 rounded-xl border px-4 py-4 transition-all duration-mid"
            style={`animation-delay: ${120 + index * 35}ms`}
          >
            <span
              class="bg-foreground block size-[22px]"
              style={`mask: url(${client.logo}) center / contain no-repeat; -webkit-mask: url(${client.logo}) center / contain no-repeat`}
              aria-hidden="true"
            />
            <p class="text-title-md text-foreground">{client.name}</p>
          </li>
        ))
      }
    </ul>

    <p
      class="animate-fade-in-up opacity-0-initial text-body-md text-foreground-faint mt-6 text-center"
      style="animation-delay: 540ms"
    >
      Anything that speaks Streamable HTTP and OAuth 2.1 can connect. There is no Exeora plugin to
      install on the client side
    </p>
  </div>
</section>
