---
import Section from "./Section.astro";

/**
 * The category distinction a buyer needs first: local MCP servers are useful
 * when client and project share a computer, while Exeora connects across that
 * boundary without moving the project into a vendor sandbox.
 */

const columns = ["Exeora", "Local MCP server", "Cloud sandbox"];

const rows = [
  {
    dimension: "Where it runs",
    values: ["Any connected machine", "The same computer as the client", "A vendor-hosted copy"],
  },
  {
    dimension: "Web clients such as ChatGPT",
    values: [
      "Connect directly over authenticated HTTP",
      "Needs a separate remote bridge",
      "Built into the vendor",
    ],
  },
  {
    dimension: "Authorization boundary",
    values: [
      "One OAuth resource per project",
      "Usually one user-level configuration",
      "One vendor account",
    ],
  },
  {
    dimension: "Real toolchain and state",
    values: ["Yes, on the target machine", "Yes, on the client machine", "Reinstalled in the copy"],
  },
  {
    dimension: "Policies and approvals",
    values: [
      "Per project, enforced at both ends",
      "Depends on the MCP server",
      "Depends on the vendor",
    ],
  },
  {
    dimension: "Central audit and revocation",
    values: ["Built in", "Usually local", "Vendor-specific"],
  },
  {
    dimension: "Setup",
    values: [
      "Connect the machine and add a project",
      "Install in every client environment",
      "Upload or import the repository",
    ],
  },
  {
    dimension: "Source",
    values: ["Full stack, AGPL-3.0", "Varies by server", "Usually closed"],
  },
];
---

<Section
  id="compare"
  eyebrow="Why Exeora"
  title="A local MCP works where the client runs. Exeora works where your project runs."
  subtitle="Reach a real development environment from any compatible AI client without turning that environment into a public endpoint"
  wide
>
  <!-- Below md the same rows are stacked, one card per dimension. A table of
       four columns cannot be read on a phone: it either shrinks past legibility
       or asks the reader to drag sideways, and dragging is the opposite of what
       a comparison is for. Both layouts are built from `columns` and `rows`, so
       the copy exists once. -->
  <div class="grid gap-3 md:hidden">
    {
      rows.map((row, rowIndex) => (
        <article
          class="animate-fade-in-up opacity-0-initial border-border bg-surface rounded-xl border p-5"
          style={`animation-delay: ${100 + rowIndex * 50}ms`}
        >
          <h3 class="text-label-md text-foreground-faint font-mono uppercase">{row.dimension}</h3>

          <dl class="divide-border-subtle mt-3 divide-y">
            {row.values.map((value, index) => (
              <div class="flex flex-col gap-0.5 py-2.5 first:pt-0 last:pb-0">
                <dt
                  class:list={[
                    "text-body-md",
                    index === 0 ? "text-foreground" : "text-foreground-muted",
                  ]}
                >
                  {columns[index]}
                </dt>
                <dd
                  class:list={[
                    "text-body-md",
                    index === 0 ? "text-foreground" : "text-foreground-muted",
                  ]}
                >
                  {value}
                </dd>
              </div>
            ))}
          </dl>
        </article>
      ))
    }
  </div>

  <!-- From md up the table fits without scrolling: the well is 720px there and
       the table asks for 672. `overflow-x-auto` stays as a guard, so a longer
       cell later scrolls this box rather than the page. -->
  <div
    class="animate-fade-in-up opacity-0-initial border-border bg-surface hidden overflow-x-auto rounded-xl border md:block"
  >
    <table class="w-full min-w-2xl border-collapse text-left">
      <thead>
        <tr class="border-border-subtle border-b">
          <th class="text-label-md text-foreground-faint px-5 py-3.5 font-mono uppercase"> </th>
          {
            columns.map((column, index) => (
              <th
                class:list={[
                  "text-title-md px-5 py-3.5",
                  index === 0
                    ? "text-foreground bg-accent-subtle"
                    : "text-foreground-muted font-normal",
                ]}
              >
                {column}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-border-subtle border-b last:border-b-0">
              <th
                scope="row"
                class="text-body-md text-foreground-muted w-56 px-5 py-3.5 font-normal"
              >
                {row.dimension}
              </th>
              {row.values.map((value, index) => (
                <td
                  class:list={[
                    "text-body-md px-5 py-3.5",
                    index === 0 ? "text-foreground bg-accent-subtle" : "text-foreground-muted",
                  ]}
                >
                  {value}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Section>
