---
import { GITHUB_URL, RELEASES_URL } from "../lib/site.js";
import Wordmark from "./Wordmark.astro";

// The build year rather than a literal, so a deploy next January does not
// leave a stale notice behind for someone to notice and file.
const year = new Date().getFullYear();

const links = [
  { href: "/dashboard/", label: "Dashboard" },
  { href: RELEASES_URL, label: "CLI", external: true },
  { href: GITHUB_URL, label: "GitHub", external: true },
  { href: "/docs/", label: "Docs" },
  { href: "/docs/tools/", label: "Tools" },
  { href: "/#security", label: "Security" },
  { href: "/#faq", label: "FAQ" },
  { href: "/brand/", label: "Brand" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
];
---

<footer class="border-border-subtle border-t px-6 py-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-5">
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <Wordmark
        class="text-foreground-muted hover:text-foreground shrink-0 transition-colors duration-fast"
      />

      <nav
        class="text-body-md text-foreground-faint flex flex-wrap items-center gap-x-5 gap-y-2 sm:justify-end"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener" : undefined}
              class="hover:text-foreground transition-colors duration-fast"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="border-border-subtle text-body-md text-foreground-faint flex flex-col gap-1 border-t pt-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>Open source · AGPL-3.0 · Your code never leaves the machine</p>
      <p class="sm:text-right">&copy; {year} Exeora</p>
    </div>
  </div>
</footer>
