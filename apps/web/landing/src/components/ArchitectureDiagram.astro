---
/**
 * How a call travels, drawn instead of described: an MCP client above, the
 * gateway in the middle, and the places a project can live below, connected by
 * a socket they opened themselves.
 *
 * Every label is something the product has: the transport, the checks the
 * gateway makes, the tool names from the contract. It stays schematic on
 * purpose; a mock of a session would be a story about one invented project.
 *
 * Motion is decoration only. With reduced motion the dots stay still and the
 * first tool call stays on screen, and the picture says the same thing.
 */

const clients = [
  { name: "Claude", logo: "/clients/claude.svg" },
  { name: "ChatGPT", logo: "/clients/chatgpt.svg" },
  { name: "Cursor", logo: "/clients/cursor.svg" },
  { name: "VS Code", logo: "/clients/vscode.svg" },
];

const checks = ["OAuth grant", "Project policy", "Audit log"];

const calls = [
  { tool: "read_file", argument: "src/server.ts" },
  { tool: "grep", argument: "DATABASE_URL" },
  { tool: "apply_patch", argument: "2 files" },
  { tool: "run_command", argument: "bun test" },
];

const locations = [
  { name: "Laptop", detail: "macOS · Linux · Windows", icon: "M4 6h16v10H4zM2 19h20" },
  {
    name: "Server or VM",
    detail: "Linux · behind NAT",
    icon: "M4 5h16v6H4zM4 13h16v6H4zM8 8h.01M8 16h.01",
  },
  {
    name: "Raspberry Pi",
    detail: "ARM · home network",
    icon: "M7 4h10v16H7zM10 8h4M10 12h4M10 16h4",
  },
  {
    name: "Exeora Cloud",
    detail: "Hosted, sleeps when idle",
    icon: "M7 18a5 5 0 1 1 1-9.9A6 6 0 0 1 19.5 10 4 4 0 0 1 18 18z",
    cloud: true,
  },
];
---

<figure
  class="border-border bg-surface/80 relative overflow-hidden rounded-2xl border p-4 text-left shadow-2xl shadow-black/30 backdrop-blur sm:p-6"
  role="img"
  aria-label="An MCP client such as Claude or ChatGPT connects to the Exeora gateway over MCP with OAuth 2.1. The gateway checks the grant, the project's policy and records the call, then relays it over a WebSocket that your laptop, server, Raspberry Pi or an Exeora Cloud instance opened outbound. Nothing listens on your machine."
>
  <!-- 1. The client -->
  <div aria-hidden="true">
    <p class="text-label-md text-foreground-faint font-mono uppercase">Your AI client</p>
    <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
      {
        clients.map((client) => (
          <li class="border-border-subtle bg-bg/60 text-body-md text-foreground flex items-center gap-2 rounded-lg border px-3 py-2">
            <span
              class="bg-current block size-4 shrink-0 opacity-80"
              style={`mask: url(${client.logo}) center / contain no-repeat; -webkit-mask: url(${client.logo}) center / contain no-repeat`}
            />
            <span class="truncate">{client.name}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- MCP request, travelling down -->
  <div class="wire" aria-hidden="true">
    <span class="wire-line"></span>
    <span class="wire-dot"></span>
    <span class="wire-label">MCP · Streamable HTTP · OAuth 2.1</span>
  </div>

  <!-- 2. The gateway -->
  <div
    class="border-brand/40 bg-brand-subtle/40 relative rounded-xl border p-4 shadow-[0_0_40px_-12px] shadow-brand/40"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between gap-3">
      <p class="text-title-md text-foreground flex items-center gap-2">
        <svg viewBox="0 0 64 44" class="size-4" fill="currentColor">
          <rect x="20" y="0" width="24" height="24" rx="4"></rect>
          <rect x="0" y="20" width="24" height="24" rx="4"></rect>
          <rect x="40" y="20" width="24" height="24" rx="4"></rect>
        </svg>
        Exeora gateway
      </p>
      <span class="text-label-md text-foreground-faint hidden font-mono sm:inline">exeora.dev · or yours</span>
    </div>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        checks.map((check) => (
          <li class="border-border bg-bg/70 text-label-md text-foreground-muted flex items-center gap-1.5 rounded-pill border px-2.5 py-1 font-mono">
            <span class="text-brand">✓</span>
            {check}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- The tool call, relayed down a socket the machine opened -->
  <div class="wire wire-tall" aria-hidden="true">
    <span class="wire-line"></span>
    <span class="wire-dot wire-dot-late"></span>
    <span class="wire-label">
      <span class="text-foreground-muted">↑ outbound WebSocket · no open port</span>
      <span class="tool-cycle mt-1.5 block">
        {
          calls.map((call) => (
            <code class="border-border bg-bg text-foreground rounded-md border px-2 py-0.5">
              <span class="text-brand">{call.tool}</span>
              <span class="text-foreground-faint"> {call.argument}</span>
            </code>
          ))
        }
      </span>
    </span>
  </div>

  <!-- 3. Where the project lives -->
  <div aria-hidden="true">
    <ul class="grid grid-cols-2 gap-2">
      {
        locations.map((location) => (
          <li
            class:list={[
              "rounded-lg border px-3 py-2.5",
              location.cloud ? "border-brand/30 bg-brand-subtle/20" : "border-border-subtle bg-bg/60",
            ]}
          >
            <div class="flex items-center gap-2">
              <svg
                viewBox="0 0 24 24"
                class="text-foreground-muted size-4 shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={location.icon} />
              </svg>
              <span class="text-body-md text-foreground truncate">{location.name}</span>
              <span class="bg-brand ml-auto size-1.5 shrink-0 rounded-full"></span>
            </div>
            <p class="text-label-md text-foreground-faint mt-1 font-mono">{location.detail}</p>
          </li>
        ))
      }
    </ul>
    <p class="text-body-md text-foreground-muted mt-4 text-center">
      Files stay on the machine. Only the result of each call crosses the wire.
    </p>
  </div>
</figure>

<style>
  .wire {
    position: relative;
    height: 4rem;
    margin-left: 1.25rem;
  }

  .wire-tall {
    height: 5.75rem;
  }

  .wire-line {
    position: absolute;
    inset-block: 0.25rem;
    left: 0;
    border-left: 1px dashed var(--color-border);
  }

  .wire-dot {
    position: absolute;
    top: 0.25rem;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-brand);
    box-shadow: 0 0 12px var(--color-brand);
    animation: wire-travel 3s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  .wire-dot-late {
    animation-delay: 1.2s;
  }

  .wire-label {
    position: absolute;
    top: 50%;
    left: 1.25rem;
    right: 0;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-foreground-faint);
  }

  /* One tool call on screen at a time. Without animation only the first
     shows, which is why the others start hidden and the first does not. */
  .tool-cycle {
    display: grid;
  }

  .tool-cycle > code {
    grid-area: 1 / 1;
    justify-self: start;
    opacity: 0;
    animation: tool-cycle 12s infinite;
  }

  .tool-cycle > code:nth-child(1) {
    opacity: 1;
  }
  .tool-cycle > code:nth-child(2) {
    animation-delay: 3s;
  }
  .tool-cycle > code:nth-child(3) {
    animation-delay: 6s;
  }
  .tool-cycle > code:nth-child(4) {
    animation-delay: 9s;
  }

  @keyframes wire-travel {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateY(calc(var(--wire-height, 3.5rem) - 7px));
      opacity: 0;
    }
  }

  .wire-tall .wire-dot {
    --wire-height: 5.25rem;
  }

  @keyframes tool-cycle {
    0% {
      opacity: 0;
      transform: translateY(4px);
    }
    3%,
    22% {
      opacity: 1;
      transform: translateY(0);
    }
    25%,
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
