---
import Section from "./Section.astro";

/**
 * The six tools an agent gets. Summaries of the contract in
 * packages/protocol/src/tools.ts, which is what the agent itself reads.
 */

const tools = [
  {
    name: "read_file",
    readOnly: true,
    body: "Read a text file whole, or a range of lines. Output is capped, and the reply says when it was cut so the agent knows to ask for the rest",
  },
  {
    name: "list_files",
    readOnly: true,
    body: "List a directory, one level or recursive, optionally filtered by a glob. Recursive walks respect .gitignore and always skip .git and node_modules",
  },
  {
    name: "grep",
    readOnly: true,
    body: "Search file contents with a regular expression. Returns paths with 1-based line numbers, under the same .gitignore rules",
  },
  {
    name: "edit_file",
    readOnly: false,
    body: "Replace an exact region of a file. If the text appears more than once the edit is refused rather than guessed, and the reply is a unified diff",
  },
  {
    name: "write_file",
    readOnly: false,
    body: "Write a file in full, creating parent directories. Overwrites entirely, which is why edit_file is the better tool for an existing file",
  },
  {
    name: "run_command",
    readOnly: false,
    body: "Run a shell command in the project directory. Bounded by a wall-clock budget, killed along with everything it started, and stdin is closed so nothing hangs waiting for input",
  },
];
---

<Section
  id="tools"
  eyebrow="Tools"
  title="Six tools, one project directory"
  subtitle="The same contract is compiled into the gateway and the CLI, so what the agent is promised and what runs cannot drift apart"
  wide
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      tools.map((tool, index) => (
        <article
          class="animate-fade-in-up opacity-0-initial border-border bg-surface hover:bg-surface-variant hover:border-foreground-faint/20 rounded-xl border p-5 transition-all duration-mid"
          style={`animation-delay: ${120 + index * 60}ms`}
        >
          <div class="flex items-center justify-between gap-3">
            <code class="text-title-md text-foreground font-mono">{tool.name}</code>
            <span
              class:list={[
                "text-label-md rounded-pill px-2 py-0.5 font-mono uppercase",
                tool.readOnly
                  ? "bg-accent-subtle text-foreground-muted"
                  : "bg-brand-subtle text-brand",
              ]}
            >
              {tool.readOnly ? "reads" : "writes"}
            </span>
          </div>
          <p class="text-body-md text-foreground-muted mt-3">{tool.body}</p>
        </article>
      ))
    }
  </div>
</Section>
