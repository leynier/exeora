---
import Clients from "../components/Clients.astro";
import Comparison from "../components/Comparison.astro";
import CtaSection from "../components/CtaSection.astro";
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import Roadmap from "../components/Roadmap.astro";
import Security from "../components/Security.astro";
import Tools from "../components/Tools.astro";
import Workflow from "../components/Workflow.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Exeora: Secure execution for AI agents, on any machine"
  description="Connect any MCP client to the development environment on any machine you can run a command on: a server, a VM, a build box, or your own laptop. No port to open, no source code to upload, no tunnel to wire up."
  canonicalPath="/"
>
  <Navbar />
  <main>
    <Hero />
    <Clients />
    <Workflow />
    <Features />
    <Tools />
    <Comparison />
    <Security />
    <Faq />
    <Roadmap />
    <CtaSection />
  </main>
  <Footer />
</Layout>
