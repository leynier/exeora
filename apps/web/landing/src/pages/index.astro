---
import Comparison from "../components/Comparison.astro";
import CtaSection from "../components/CtaSection.astro";
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import Security from "../components/Security.astro";
import Workflow from "../components/Workflow.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Exeora"
  description="Exeora securely connects AI coding agents and MCP clients to development projects on machines you control. Google Sign-In uses only basic identity data for authentication."
  canonicalPath="/"
>
  <Navbar />
  <main>
    <Hero />
    <Workflow />
    <Comparison />
    <Features />
    <Security />
    <Faq />
    <CtaSection />
  </main>
  <Footer />
</Layout>
