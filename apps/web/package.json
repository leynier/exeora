{
  "name": "@exeora/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:landing && bun run build:dashboard",
    "build:landing": "astro build --root landing --outDir ../public",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@exeora/design": "workspace:*",
    "@exeora/protocol": "workspace:*",
    "@lezer/highlight": "1.2.4",
    "@pierre/diffs": "1.3.6",
    "@tanstack/react-query": "5.102.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.16",
    "lucide-react": "1.48.0",
    "marked": "18.0.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "astro": "7.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  },
  "description": "Static sources for the Exeora site. Built here, served by the gateway Worker."
}
