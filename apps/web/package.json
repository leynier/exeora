{
  "name": "@exeora/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:landing && bun run build:dashboard",
    "build:landing": "astro build --root landing --outDir ../public",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "deploy": "bun run build && wrangler deploy",
    "preview": "bun run build && wrangler dev"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "astro": "7.1.6",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "vite": "8.2.0",
    "wrangler": "4.119.0"
  }
}
